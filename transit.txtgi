-- schemas for the three missing tables
SELECT TABLE_NAME, COLUMN_NAME, DATA_TYPE
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME IN ('asqa_rmasignificantevent','asqa_thirdpartyarrangements','asqa_studentmanagementsystem')
ORDER BY TABLE_NAME, ORDINAL_POSITION;

-- which submission types spawn many FPP records
SELECT s.asqa_registrationsubmissiontypename, f.asqa_relatedsubmission, COUNT(*) AS fpp_rows
FROM dbo.asqa_rtofitandproperperson f
JOIN dbo.asqa_registrationsubmission s ON s.Id = f.asqa_relatedsubmission
WHERE f.IsDelete IS NULL AND s.IsDelete IS NULL
GROUP BY s.asqa_registrationsubmissiontypename, f.asqa_relatedsubmission;
