SELECT EntityName, OptionSetName, [Option], LocalizedLabel
FROM dbo.OptionsetMetadata
WHERE EntityName LIKE 'asqa[_]%';

SELECT * FROM dbo.GlobalOptionsetMetadata;  -- small, send it all
SELECT * FROM dbo.StatusMetadata WHERE EntityName LIKE 'asqa[_]%';
SELECT * FROM dbo.StateMetadata  WHERE EntityName LIKE 'asqa[_]%';
