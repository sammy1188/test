
-- 1. real targets of the pointers I couldn't name
SELECT v.fk, v.target, COUNT(*) AS n
FROM dbo.asqa_registrationsubmission s
CROSS APPLY (VALUES
 ('rmasignificantevent', s.asqa_rmasignificantevent_entitytype),
 ('thirdpartyarrangements', s.asqa_thirdpartyarrangements_entitytype),
 ('studentmangementsystem', s.asqa_studentmangementsystem_entitytype),
 ('rtoscopeapplication', s.asqa_rtoscopeapplication_entitytype),
 ('rtoscopeitem', s.asqa_rtoscopeitem_entitytype),
 ('contact', s.asqa_contact_entitytype),
 ('rtofppd', s.asqa_rtofppd_entitytype),
 ('rtodelegationid', s.asqa_rtodelegationid_entitytype),
 ('rtoenquiry', s.asqa_rtoenquiry_entitytype),
 ('rtofinancialstatus', s.asqa_rtofinancialstatus_entitytype),
 ('rtodeliverylocation', s.asqa_rtodeliverylocation_entitytype)
) v(fk, target)
WHERE v.target IS NOT NULL AND s.IsDelete IS NULL
GROUP BY v.fk, v.target ORDER BY v.fk;

-- 2. do children point up to many submissions?
SELECT 'rtoscope' AS child, COUNT(*) AS total, COUNT(asqa_registrationsubmission) AS has_parent,
       COUNT(DISTINCT asqa_registrationsubmission) AS distinct_parents
FROM dbo.asqa_rtoscope WHERE IsDelete IS NULL
UNION ALL
SELECT 'rtopublishrequest', COUNT(*), COUNT(asqa_submission), COUNT(DISTINCT asqa_submission)
FROM dbo.asqa_rtopublishrequest WHERE IsDelete IS NULL
UNION ALL
SELECT 'rtofitandproperperson', COUNT(*), COUNT(asqa_relatedsubmission), COUNT(DISTINCT asqa_relatedsubmission)
FROM dbo.asqa_rtofitandproperperson WHERE IsDelete IS NULL;

-- 3. are the orphan renewals unsubmitted drafts?
SELECT r.Id, r.createdon, r.statecode, r.asqa_renewalsubmitted, r.asqa_renewaltype, r.asqa_setrenewalduedate
FROM dbo.asqa_rtorenewal r
WHERE r.IsDelete IS NULL
  AND NOT EXISTS (SELECT 1 FROM dbo.asqa_registrationsubmission s
                  WHERE s.asqa_rtorenewal = r.Id AND s.IsDelete IS NULL)
ORDER BY r.createdon;
