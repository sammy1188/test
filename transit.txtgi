SELECT asqa_relatedsubmission_entitytype AS target,
       COUNT(*) AS fpp_rows,
       COUNT(DISTINCT asqa_relatedsubmission) AS parents,
       COUNT(asqa_rtorenewal) AS has_renewal,
       COUNT(asqa_rtoaccountcontactrole) AS has_contact_role
FROM dbo.asqa_rtofitandproperperson
WHERE IsDelete IS NULL
GROUP BY asqa_relatedsubmission_entitytype;
